OPENAI_API_KEY=your_openai_api_key_here
SEARCH_CONTEXT_SIZE=medium  # Options: low, medium, high
REASONING_EFFORT=high     # Options: none, low, medium, high, xhigh, max
OUTPUT_VERBOSITY=medium     # Options: low, medium, high
OPENAI_API_TIMEOUT=300000   # API timeout in milliseconds (default: 300000)
OPENAI_MAX_RETRIES=3        # Maximum retry attempts (default: 3)
